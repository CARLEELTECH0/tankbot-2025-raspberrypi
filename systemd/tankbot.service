[Unit]
Description=Tankbot 2025 Raspberry Pi Robotics & Mobile UI Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/tankbot_raspberrypi
ExecStart=/usr/bin/python3 /home/pi/tankbot_raspberrypi/main.py --port 8080
Restart=on-failure
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
